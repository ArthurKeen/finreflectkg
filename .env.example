# -- ArangoDB connection -------------------------------------------------------
# Endpoint of your ArangoDB 3.12.x Enterprise deployment.
ARANGO_ENDPOINT=https://your-arango-endpoint:8529
ARANGO_DB=FinReflectKG
ARANGO_USER=root
ARANGO_PASSWORD=changeme
# Set to false only for self-signed certs in trusted/dev environments.
ARANGO_VERIFY_SSL=true
ARANGO_TIMEOUT=120

# -- Dataset -------------------------------------------------------------------
# Hugging Face dataset id (downloaded by scripts/download.py).
HUGGINGFACE_DATASET=domyn/FinReflectKG
